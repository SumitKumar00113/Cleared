                # Supabase project (server-side API configuration; never expose the service role key to the browser)
                SUPABASE_URL=
                SUPABASE_PUBLISHABLE_KEY=
                # Only add this when a reviewed server-only admin/scanner operation requires it.
                # Never use this for ordinary tenant queries; it bypasses RLS.
                SUPABASE_SECRET_KEY=

                # Public application URL used in email verification and password reset links
                APP_BASE_URL=http://localhost:5173

                # Optional malware scanning worker endpoint; uploads remain quarantined if scanning is unavailable
                MALWARE_SCANNER_URL=
                MALWARE_SCANNER_TOKEN=

                # Existing verification provider
                GEMINI_API_KEY=
                GEMINI_MODEL=gemini-3.8-flash

                # Legacy SQLite/in-memory auth only; remove after the managed Auth migration is complete.
                SESSION_SECRET=
                GEMINI_API_KEY=
                GEMINI_MODEL=gemini-3.8-flash
