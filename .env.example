# Local API configuration. Set a random secret of 32+ characters before signing in.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
NODE_ENV=development
PORT=4000
WEB_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_BASE_URL=http://localhost:5173

# Production mail and MFA. MAIL_FROM should be a verified sender at your provider.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Cleared <security@example.com>
# Local development key only. Replace with a random 32-byte key in production.
MFA_ENCRYPTION_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f

# Private upload storage and scanning. Local development is the default.
FILE_STORAGE=local
# LOCAL_STORAGE_DIR=./private-storage
FILE_SCANNER=none
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310

# Production: set FILE_STORAGE=s3, keep the bucket private, and provide credentials.
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=cleared-private
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=

# Optional. AI verification is unavailable unless configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional local database path; default is apps/api/data/cleared.sqlite
# CLEARED_DB_PATH=

# Production must set NODE_ENV=production, SESSION_SECRET, HTTPS APP_BASE_URL,
# HTTPS CORS_ORIGINS, SMTP settings, MAIL_FROM, MFA_ENCRYPTION_KEY, private S3
# storage variables, and FILE_SCANNER=clamav with a reachable CLAMAV_HOST.
