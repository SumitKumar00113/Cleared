# Local API configuration. Set a random secret of 32+ characters before signing in.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
NODE_ENV=development
PORT=4000
WEB_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_BASE_URL=http://localhost:5173

# Optional. AI verification is unavailable unless configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional local database path; default is apps/api/data/cleared.sqlite
# CLEARED_DB_PATH=

# Production must set NODE_ENV=production, SESSION_SECRET, and an explicit CORS_ORIGINS allow-list.
